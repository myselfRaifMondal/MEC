{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npm --prefix mideast-3d ci --include=dev && npm --prefix mideast-3d run build && mkdir -p dist/timeline && cp -R mideast-3d/dist/. dist/timeline/",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/timeline",
      "destination": "/timeline/index.html"
    },
    {
      "source": "/((?!attachments/|timeline/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/timeline/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
